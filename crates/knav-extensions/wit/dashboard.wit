// The whole API a WASM dashboard gets. There are no imports, so a guest can't call
// back into knav; everything it needs arrives as data in `lines`. The host side is
// crates/knav-extensions/src/dashboards/wasm.rs.
package knav:extension;

interface types {
    record kind-data {
        group: string,
        kind: string,
        objects: list<string>,
    }

    record line {
        spans: list<span>,
    }

    record span {
        text: string,
        style: style-hint,
    }

    /// A meaning, not a colour: knav picks the colour, so a dashboard can't style
    /// itself to look like another part of the UI.
    enum style-hint {
        plain,
        muted,
        ok,
        warn,
        bad,
        accent,
        bold,
        heading,
    }
}

world dashboard {
    use types.{kind-data, line, span, style-hint};

    /// Called every frame the dashboard shows. `data` has one entry per kind the manifest
    /// declares, in order, each object as a JSON string.
    export lines: func(data: list<kind-data>) -> list<line>;
}
